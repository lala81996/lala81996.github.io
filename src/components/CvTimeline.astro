---
import { getCollection, type CollectionEntry } from 'astro:content';
import { compareCvDates } from '../lib/cv-date';

type Station = CollectionEntry<'cv'>['data'];

// '9999' ranks running stations first.
const sortKey = (station: Station) => station.end ?? '9999';

const stations = (await getCollection('cv'))
	.map((entry) => entry.data)
	.sort(
		(a, b) =>
			compareCvDates(sortKey(b), sortKey(a)) ||
			compareCvDates(b.start, a.start),
	);

const groups = [
	{ key: 'work', label: 'Beruf' },
	{ key: 'engagement', label: 'Engagement' },
	{ key: 'education', label: 'Ausbildung' },
]
	.map((group) => ({
		...group,
		stations: stations.filter((station) => station.group === group.key),
	}))
	.filter((group) => group.stations.length > 0);

function formatDate(value: string): string {
	const [year, month] = value.split('-');
	return month ? `${month}/${year}` : year;
}
---

<div class="cv">
	{
		groups.map((group) => (
			<div class="cv-group">
				<h3 class="eyebrow cv-group-title">{group.label}</h3>
				<ol class="divided-list cv-list" role="list">
					{group.stations.map((station) => (
						<li class="cv-item">
							<p class="cv-period">
								{station.end === undefined && 'seit '}
								<time datetime={station.start}>
									{formatDate(station.start)}
								</time>
								{station.end !== undefined && station.end !== station.start && (
									<>
										{' – '}
										<time datetime={station.end}>
											{formatDate(station.end)}
										</time>
									</>
								)}
							</p>
							<div class="cv-content">
								<p class="cv-title">{station.title}</p>
								<p class="cv-meta">{station.organization}</p>
								{station.details.length > 0 && (
									<ul class="inline-list cv-meta" role="list">
										{station.details.map((detail) => (
											<li>{detail}</li>
										))}
									</ul>
								)}
							</div>
						</li>
					))}
				</ol>
			</div>
		))
	}
</div>

<style>
	.cv {
		display: grid;
		gap: var(--space-l) var(--space-m);
	}

	.cv-group-title {
		margin-block-end: var(--space-s);
		color: var(--color-text-muted);
	}

	.cv-item {
		display: grid;
		row-gap: var(--space-xs);
		align-items: baseline;
		padding-block: var(--space-s);
	}

	.cv-period {
		margin: 0;
		color: var(--color-text-muted);
		font-size: var(--text-s);
		font-variant-numeric: tabular-nums;
	}

	.cv-content {
		max-width: var(--measure);
	}

	.cv-title {
		margin: 0;
		font-size: var(--text-m);
		font-weight: 600;
	}

	.cv-meta {
		margin: 0;
		color: var(--color-text-muted);
		font-size: var(--text-s);
	}

	/* Subgrid down to each item aligns the period column across both groups,
	   sized by the longest period instead of a fixed width. */
	@media (min-width: 48rem) {
		.cv {
			grid-template-columns: max-content minmax(0, 1fr);
		}

		.cv-group,
		.cv-list,
		.cv-item {
			display: grid;
			grid-column: 1 / -1;
			grid-template-columns: subgrid;
		}

		.cv-group-title {
			grid-column: 1 / -1;
		}
	}
</style>
