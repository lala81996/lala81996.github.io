---
import type { HTMLAttributes } from 'astro/types';

type Props = HTMLAttributes<'div'>;

const { class: className, ...rest } = Astro.props;
---

<div class:list={['visual', className]} {...rest} aria-hidden="true">
	<canvas data-gradient></canvas>
</div>

<style>
	.visual {
		position: relative;
		overflow: hidden;
		width: 100%;
		max-width: var(--visual-max-width);
		aspect-ratio: 1;
		border-radius: var(--radius-l);
		background-image: var(--gradient-brand);
	}

	canvas {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		opacity: 0;
	}

	canvas[data-ready] {
		opacity: 1;
	}

	@media (prefers-reduced-motion: no-preference) {
		canvas {
			transition: opacity 0.6s;
		}
	}
</style>

<script>
	import { mountGradient } from '../lib/gradient-shader';

	for (const canvas of document.querySelectorAll<HTMLCanvasElement>(
		'canvas[data-gradient]',
	)) {
		mountGradient(canvas);
	}
</script>
