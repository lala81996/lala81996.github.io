---
import { getCollection } from 'astro:content';
import GradientVisual from './GradientVisual.astro';

const quotes = (await getCollection('zitate')).map((entry) => entry.data.text);
---

<section class="hero" aria-label="Ein Gedanke für zwischendurch">
	<GradientVisual class="hero-visual" />
	<blockquote class="quote" data-quotes={JSON.stringify(quotes)}>
		<p data-quote-text>{quotes[0]}</p>
	</blockquote>
</section>

<style>
	.hero {
		position: relative;
		isolation: isolate;
		display: grid;
		min-height: calc(100svh - var(--space-xl) - var(--space-l));
		padding: clamp(var(--space-m), 4vw, var(--space-l));
		overflow: hidden;
		border-radius: var(--radius-xl);
		color: var(--color-on-gradient);
	}

	/* Two classes beat the single-class sizing rules inside GradientVisual. */
	.hero .hero-visual {
		position: absolute;
		inset: 0;
		z-index: -1;
		max-width: none;
		aspect-ratio: auto;
		border-radius: 0;
	}

	.quote {
		align-self: end;
		max-width: var(--measure-quote);
		margin: 0;
		font-family: var(--font-display);
		font-size: var(--text-hero);
		font-weight: 600;
		line-height: var(--leading-tight);
		letter-spacing: var(--tracking-tight);
	}

	.quote p {
		margin: 0;
	}

	/* The spans below are created by the script, so they carry no scope attribute. */

	/* The untyped rest stays in the layout so lines wrap as in the finished
	   quote and the block does not grow while typing. */
	.quote :global(.rest) {
		opacity: 0;
	}

	/* The negative margin keeps the caret from shifting the following text. */
	.quote :global(.caret) {
		margin-inline-end: calc(var(--underline-thickness) * -1);
		border-inline-start: var(--underline-thickness) solid;
		animation: blink calc(var(--duration-m) * 2) steps(1) infinite;
	}

	.quote :global(.caret.is-typing) {
		animation: none;
	}

	@keyframes blink {
		50% {
			opacity: 0;
		}
	}
</style>

<script>
	// Typing rhythm in ms. The jitter and the pause after punctuation keep it
	// from looking mechanical.
	const START_DELAY = 400;
	const TYPE_INTERVAL = 70;
	const TYPE_JITTER = 40;
	const PUNCTUATION_PAUSE = 250;
	const ERASE_INTERVAL = 35;
	const RETYPE_DELAY = 400;
	// Long enough to read a short quote twice before it is replaced.
	const HOLD_DURATION = 3000;

	const wait = (ms: number) =>
		new Promise<void>((resolve) => setTimeout(resolve, ms));

	const pick = (items: readonly string[]): string | undefined =>
		items[Math.floor(Math.random() * items.length)];

	const typingDelay = (char: string) =>
		TYPE_INTERVAL +
		(Math.random() - 0.5) * TYPE_JITTER +
		(/[.,!?]/.test(char) ? PUNCTUATION_PAUSE : 0);

	function createSpan(className?: string): HTMLSpanElement {
		const span = document.createElement('span');
		if (className) {
			span.className = className;
		}
		return span;
	}

	async function animate(
		text: HTMLElement,
		first: string,
		second: string | undefined,
	) {
		const typed = createSpan();
		const caret = createSpan('caret');
		const rest = createSpan('rest');
		caret.setAttribute('aria-hidden', 'true');

		const render = (value: string, length: number) => {
			typed.textContent = value.slice(0, length);
			rest.textContent = value.slice(length);
		};

		const type = async (value: string) => {
			caret.classList.add('is-typing');
			for (let length = 1; length <= value.length; length++) {
				render(value, length);
				await wait(typingDelay(value.charAt(length - 1)));
			}
			caret.classList.remove('is-typing');
		};

		const erase = async (value: string) => {
			caret.classList.add('is-typing');
			for (let length = value.length - 1; length >= 0; length--) {
				render(value, length);
				await wait(ERASE_INTERVAL);
			}
		};

		render(first, 0);
		text.replaceChildren(typed, caret, rest);

		await wait(START_DELAY);
		await type(first);
		if (second) {
			await wait(HOLD_DURATION);
			await erase(first);
			render(second, 0);
			await wait(RETYPE_DELAY);
			await type(second);
		}
		// A caret blinking indefinitely would fail WCAG 2.2.2.
		caret.remove();
	}

	const quote = document.querySelector<HTMLElement>('[data-quotes]');
	const text = quote?.querySelector<HTMLElement>('[data-quote-text]');
	const quotes: string[] = JSON.parse(quote?.dataset.quotes ?? '[]');
	const first = pick(quotes);
	const second = pick(quotes.filter((value) => value !== first));

	if (text && first) {
		if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
			text.textContent = first;
			if (second) {
				setTimeout(() => (text.textContent = second), HOLD_DURATION);
			}
		} else {
			void animate(text, first, second);
		}
	}
</script>
