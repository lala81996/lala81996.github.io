---
import { getCollection } from 'astro:content';
import CopyButton from '../components/CopyButton.astro';
import CvTimeline from '../components/CvTimeline.astro';
import ProjectPanel from '../components/ProjectPanel.astro';
import QuoteHero from '../components/QuoteHero.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { comparePeriodsDesc } from '../lib/partial-date';

const areas = (await getCollection('areas')).sort(
	(a, b) => a.data.order - b.data.order,
);

const projects = (await getCollection('projects')).sort(
	(a, b) =>
		comparePeriodsDesc(a.data, b.data) ||
		a.data.title.localeCompare(b.data.title),
);
---

<BaseLayout title="lolga8">
	<QuoteHero />

	<section class="chapter container" aria-labelledby="hallo">
		<p class="eyebrow chapter-label"><span>01</span> Hello</p>
		<div class="chapter-body">
			<h1 id="hallo" class="chapter-title display">Hi, ich bin Laura.</h1>
			<div class="prose">
				<p>
					In meinem aktuellen Team verantworte ich alles rund ums Frontend, von
					der ersten Idee bis zum Deployment. Mit Kund*innen kläre ich, was
					gebraucht wird, helfe bei der Lösung von Problemen und konzipiere die
					Oberflächen. <strong class="highlight">Und dann baue ich es</strong>:
					seit fast sieben Jahren vor allem mit Angular und TypeScript und mit
					allem, was sich für ein Projekt als richtig herausstellt.
				</p>
				<p>
					Diese Seite ist meine digitale Visitenkarte: ein Lebenslauf zum
					Durchscrollen und ein kleiner Einblick in meine Projekte und die
					Probleme, die ich darin löse.
				</p>
			</div>
		</div>
	</section>

	<section class="chapter container" aria-labelledby="bereiche">
		<p class="eyebrow chapter-label"><span>02</span> Bereiche</p>
		<div class="chapter-body">
			<h2 id="bereiche" class="chapter-title display">Was ich kann.</h2>
			<p class="chapter-hint">
				An diesen Themenfeldern arbeite ich. Zu jedem siehst du meine
				Schwerpunkte und die Tools, mit denen ich dort regelmäßig arbeite.
			</p>
			<ol class="divided-list">
				{
					areas.map((area) => (
						<li class="area" id={`bereich-${area.id}`}>
							<span class="area-number" aria-hidden="true">
								{String(area.data.order).padStart(2, '0')}
							</span>
							<h3 class="area-title display">{area.data.title}</h3>
							<dl class="label-list area-details">
								{[
									{ label: 'Schwerpunkte', items: area.data.focus },
									{ label: 'Tools', items: area.data.tools },
								]
									.filter((group) => group.items.length > 0)
									.map((group) => (
										<>
											<dt class="eyebrow">{group.label}</dt>
											<dd>
												<ul class="inline-list" role="list">
													{group.items.map((item) => (
														<li>{item}</li>
													))}
												</ul>
											</dd>
										</>
									))}
							</dl>
						</li>
					))
				}
			</ol>
		</div>
	</section>

	<section class="chapter container" aria-labelledby="projekte">
		<p class="eyebrow chapter-label"><span>03</span> Projekte</p>
		<div class="chapter-body">
			<h2 id="projekte" class="chapter-title display">
				Woran ich gearbeitet habe.
			</h2>
			<p class="chapter-hint">
				Über die Jahre habe ich an vielen Projekten und Produkten mitgearbeitet.
				Die meisten gehören Kund*innen oder meinem Team, und deren
				Vertraulichkeit ist mir wichtig. Deshalb zeige ich hier nur eine kleine
				Auswahl. Wenn du mehr wissen willst,
				<a class="link" href="#kontakt">schreib mir einfach</a>.
			</p>
			<div class="projects">
				{projects.map((project) => <ProjectPanel project={project} />)}
			</div>
		</div>
	</section>

	<section class="chapter container" aria-labelledby="lebenslauf">
		<p class="eyebrow chapter-label"><span>04</span> Lebenslauf</p>
		<div class="chapter-body">
			<h2 id="lebenslauf" class="chapter-title display">Wie ich hierherkam.</h2>
			<CvTimeline />
		</div>
	</section>

	<section class="chapter container contact" aria-labelledby="kontakt">
		<p class="eyebrow chapter-label"><span>05</span> Kontakt</p>
		<div class="chapter-body">
			<h2 id="kontakt" class="chapter-title display">
				Ich freue mich über Post.
			</h2>
			<div class="contact-links">
				<div class="contact-row">
					<a class="link contact-link" href="mailto:hello@lolga8.com"
						>hello@lolga8.com<span class="link-arrow" aria-hidden="true">→</span
						></a
					>
					<CopyButton
						value="hello@lolga8.com"
						label="E-Mail-Adresse kopieren"
					/>
				</div>
				<a
					class="link contact-link"
					href="https://www.linkedin.com/in/laura-burkhardt-2a4199172/"
					rel="me"
					>LinkedIn<span class="link-arrow" aria-hidden="true">→</span></a
				>
			</div>
		</div>
	</section>
</BaseLayout>

<style>
	.chapter {
		display: grid;
		gap: var(--space-m);
		padding-block: var(--space-xl);
		border-block-end: var(--border-hairline) solid var(--color-line);
	}

	.chapter-label {
		display: flex;
		gap: var(--space-xs);
		align-items: baseline;
		color: var(--color-text-muted);
	}

	.chapter-label span {
		color: var(--color-text);
		font-variant-numeric: tabular-nums;
	}

	.chapter-title {
		max-width: var(--measure-heading);
		margin: 0 0 var(--space-l);
		font-size: var(--text-xl);
		line-height: var(--leading-snug);
		text-wrap: balance;
	}

	.prose {
		max-width: var(--measure);
		font-size: var(--text-l);
	}

	.prose p {
		margin: 0 0 var(--space-m);
	}

	.chapter-hint {
		max-width: var(--measure);
		margin: 0 0 var(--space-m);
		color: var(--color-text-muted);
		font-size: var(--text-m);
	}

	.area {
		display: grid;
		grid-template-columns: auto 1fr;
		gap: 0 var(--space-m);
		align-items: baseline;
		padding-block: var(--space-m);
	}

	.area-number {
		color: var(--color-text-muted);
		font-size: var(--text-s);
		font-weight: 600;
		font-variant-numeric: tabular-nums;
	}

	.area-title {
		margin: 0;
		font-size: var(--text-l);
	}

	.area-details {
		grid-column: 2;
		margin-block-start: var(--space-xs);
	}

	.projects {
		display: grid;
		gap: var(--space-l);
		margin-block-start: var(--space-l);
	}

	.contact {
		padding-block-end: var(--space-2xl);
		border-block-end: none;
	}

	.contact-links {
		display: grid;
		gap: var(--space-m);
		justify-items: start;
	}

	.contact-row {
		display: flex;
		flex-wrap: wrap;
		gap: var(--space-s);
		align-items: center;
	}

	.contact-link {
		font-size: var(--text-l);
		font-weight: 600;
	}

	@media (min-width: 48rem) {
		.contact-links {
			display: flex;
			flex-wrap: wrap;
			align-items: center;
			justify-content: space-between;
		}

		.chapter {
			grid-template-columns: minmax(0, 1fr) minmax(0, 3fr);
			gap: var(--space-l);
		}

		.chapter-label {
			position: sticky;
			top: var(--space-l);
			align-self: start;
		}
	}

	@media (min-width: 75rem) {
		.area {
			grid-template-columns: var(--space-l) minmax(0, 1fr) minmax(0, 1fr);
		}

		.area-details {
			grid-column: 3;
			margin: 0;
		}
	}
</style>
